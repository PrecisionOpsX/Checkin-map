rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isUser(uid) { return isSignedIn() && request.auth.uid == uid; }

    function onlyFollowCountChanged() {
      let allowed = ['followersCount', 'followingCount', 'updatedAt'];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(allowed);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isUser(userId);
      allow update: if isUser(userId) || (isSignedIn() && onlyFollowCountChanged());
      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Curated locations. For now they are seeded from the app's hard-coded
    // sample data, but the schema is ready for the admin panel (M4).
    match /locations/{locationId} {
      allow read: if isSignedIn();
      // Only the admin panel writes to this collection. End users cannot.
      allow write: if false;
    }

    // GPS-verified check-ins. Users create their own and may only check
    // themselves out.
    match /checkins/{checkinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.checkedOutAt == null;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.locationId == resource.data.locationId;
      allow delete: if false;
    }
  }
}
