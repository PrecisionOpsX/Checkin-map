# Copy this file to .env and fill in values from your Firebase project:
# https://console.firebase.google.com -> Your Project -> Project Settings ->
# General -> Your apps -> Web app config.

# Required for Auth and Firestore
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Leave EMPTY if you have not enabled Firebase Storage.
# When empty, profile photo upload is disabled but everything else works.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
