# Copy this file to .env and fill in values.

# === Firebase (required for Auth + Firestore) ===
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional. Leave EMPTY if you have not enabled Firebase Storage.
# When empty, profile photo upload is disabled but everything else works.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# === Google Maps (Milestone 2) ===
# Not required during Expo Go development:
#   - iOS uses Apple Maps (no key needed)
#   - Android in Expo Go uses Expo's shared dev key
# Required at production EAS Build time. Get free keys from Google Cloud
# Console -> Maps SDK for Android / iOS. The client will provide the
# final production keys before launch.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# === Dev convenience ===
# Override the initial map center when no GPS permission yet.
# Defaults to roughly Manhattan, where the sample locations live.
EXPO_PUBLIC_DEV_LAT=
EXPO_PUBLIC_DEV_LNG=
